# IBM watsonx.ai (optional — not consumed by the current MCP server;
# scoped for a future direct watsonx.ai call, not required to run this build)
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Backend (port is hardcoded in uvicorn — these are for reference only)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# Database (optional — not used in current mock data version)
# DATABASE_URL=sqlite:///./coldchain.db